{
  "version": "quran-reflect-post-rendering/v1",
  "cases": [
    {
      "name": "empty body",
      "post": {
        "body": ""
      },
      "lines": [],
      "html": ""
    },
    {
      "name": "plain text escapes html and keeps line breaks",
      "post": {
        "body": "a < b & \"c\"\n\n<script>x</script>"
      },
      "lines": [
        {
          "segments": [
            {
              "text": "a < b & \"c\""
            }
          ]
        },
        {
          "segments": []
        },
        {
          "segments": [
            {
              "text": "<script>x</script>"
            }
          ]
        }
      ],
      "html": "a &lt; b &amp; &quot;c&quot;<br><br>&lt;script&gt;x&lt;/script&gt;"
    },
    {
      "name": "formatting null is plain text",
      "post": {
        "body": "Hello world",
        "formatting": null,
        "mentions": null
      },
      "lines": [
        {
          "segments": [
            {
              "text": "Hello world"
            }
          ]
        }
      ],
      "html": "Hello world"
    },
    {
      "name": "inline styles overlap",
      "post": {
        "body": "Hello world",
        "formatting": [
          {
            "type": "BOLD",
            "start": 0,
            "end": 5
          },
          {
            "type": "ITALIC",
            "start": 3,
            "end": 11
          },
          {
            "type": "UNDERLINE",
            "start": 0,
            "end": 11
          }
        ]
      },
      "lines": [
        {
          "segments": [
            {
              "text": "Hel",
              "bold": true,
              "underline": true
            },
            {
              "text": "lo",
              "bold": true,
              "italic": true,
              "underline": true
            },
            {
              "text": " world",
              "italic": true,
              "underline": true
            }
          ]
        }
      ],
      "html": "<u><strong>Hel</strong></u><u><em><strong>lo</strong></em></u><u><em> world</em></u>"
    },
